# Recommended: Google Cloud Vertex AI with Application Default Credentials.
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=your-google-cloud-project-id
GOOGLE_CLOUD_LOCATION=global

# Optional compatibility mode. Leave blank when using Vertex AI.
GEMINI_API_KEY=

# Optional overrides.
GEMINI_TEXT_MODEL=gemini-3.5-flash
GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
QUALITY_THRESHOLD=78
MAX_RETRIES=1

# Enables a no-cost synthetic-audio walkthrough. Never use it as proof of AI TTS.
DEMO_MODE=false

# Optional: upload the completed ZIP and WAV files to this Google Cloud Storage bucket.
GCS_BUCKET=

# Cloud Run persistence. Keep false for an entirely local workspace.
FIRESTORE_ENABLED=false
FIRESTORE_DATABASE=(default)
USE_ADK_ORCHESTRATION=false
CLOUD_TASKS_QUEUE=
CLOUD_TASKS_LOCATION=asia-east1
CLOUD_TASKS_SERVICE_ACCOUNT=

# Required only for the authenticated Cloud Storage Auto Production Inbox.
EVENTARC_SERVICE_ACCOUNT=
ROLEVOX_EVENT_AUDIENCE=
ROLEVOX_PUBLIC_URL=
